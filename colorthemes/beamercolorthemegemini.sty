% UC Riverside brand palette. Values are taken verbatim from
% https://brand.ucr.edu/ucr-colors

\definecolor{ucrblue}{HTML}{003DA5}
\definecolor{ucrgold}{HTML}{FFB81C}
\definecolor{ucrwhite}{HTML}{FFFFFF}
\definecolor{ucrblack}{HTML}{000000}
\definecolor{ucrgray}{HTML}{4C4C4C}

% Primary UCR Blue anchors the design; gold is used sparingly as an accent.
\setbeamercolor{palette primary}{fg=ucrblue,bg=ucrwhite}
\setbeamercolor{palette secondary}{fg=ucrblue,bg=ucrwhite}
\setbeamercolor{palette tertiary}{bg=ucrblue,fg=ucrwhite}
\setbeamercolor{palette quaternary}{fg=ucrblue,bg=ucrwhite}
\setbeamercolor{structure}{fg=ucrblue}

\setbeamercolor{headline}{fg=ucrwhite,bg=ucrblue}
\setbeamercolor{headline title}{fg=ucrwhite}
\setbeamercolor{headline author}{fg=ucrwhite}
\setbeamercolor{headline institute}{fg=ucrwhite}
\setbeamercolor{headline rule}{bg=ucrgold}

\setbeamercolor{block title}{fg=ucrblue,bg=ucrwhite}
\setbeamercolor{block separator}{bg=ucrgold}
\setbeamercolor{block body}{fg=ucrblack,bg=ucrwhite}

\setbeamercolor{block title alerted}{fg=ucrblue,bg=ucrgold}
\setbeamercolor{block separator alerted}{bg=ucrblue}
\setbeamercolor{block body alerted}{fg=ucrblack,bg=ucrgold}

\setbeamercolor{block title example}{fg=ucrwhite,bg=ucrblue}
\setbeamercolor{block separator example}{bg=ucrgold}
\setbeamercolor{block body example}{fg=ucrblack,bg=ucrwhite}

\setbeamercolor{heading}{fg=ucrblue}
\setbeamercolor{item}{fg=ucrblue}
\setbeamercolor{bibliography item}{fg=ucrblue}
\setbeamercolor{bibliography entry author}{fg=ucrblack}
\setbeamercolor{bibliography entry title}{fg=ucrblack}
\setbeamercolor{bibliography entry location}{fg=ucrblack}
\setbeamercolor{bibliography entry note}{fg=ucrblack}
